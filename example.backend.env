OPENAI_API_KEY=
DATASET_PATH=/data/mapai_chatbot_dataset.csv
CHATBOT_PERSIST_PATH=/data/chatbot_db
OPENAI_MODEL=gpt-4o-mini
NUM_DOCS=5
CHATBOT_TEMPERATURE=0
CHATBOT_MAX_TOKENS=600

# Redis (container DNS)
REDIS_URL=redis://redis:6379/0
SESSION_TTL_HOURS=24

# SECURITY — generate a long random value
SECRET_KEY=

# Brute-force protection
MAX_LOGIN_ATTEMPTS=15
LOCKOUT_MINUTES=30
